{
  "name": "skvallerbyttan",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm test && npm run typecheck && npm run validate:bindings && npm run validate:worker",
    "predeploy": "npm run check",
    "deploy": "wrangler deploy",
    "predeploy:production": "npm run check",
    "deploy:production": "node scripts/deploy-production.mjs",
    "test": "tsx --test test/*.test.ts && node --test scripts/deploy-production.test.mjs",
    "typecheck": "tsc --noEmit",
    "validate:bindings": "node scripts/validate-bindings.mjs",
    "validate:worker": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260814.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "wrangler": "4.127.0"
  }
}
